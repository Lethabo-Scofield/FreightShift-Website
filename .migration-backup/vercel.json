{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/freightshift... run build",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "outputDirectory": "artifacts/freightshift/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
