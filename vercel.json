{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/freightshift run build",
  "outputDirectory": "artifacts/freightshift/dist/public",
  "rewrites": [
    { "source": "/api/olyxee/:path*", "destination": "https://logistics.olyxee.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
